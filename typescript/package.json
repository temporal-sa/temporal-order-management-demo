{
  "name": "temporal-order-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --build && node lib/scripts/create-bundle.js",
    "codec-server": "ts-node src/codec-server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "ts-node src/worker.ts",
    "start.watch": "nodemon src/worker.ts"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "//": "protobufjs is a direct dependency so every @temporalio/* package resolves to one hoisted copy; two copies break instanceof and throw 'type must be a Type'",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/common": "1.23.0",
    "@temporalio/envconfig": "1.23.0",
    "@temporalio/external-storage-s3": "1.23.0",
    "@temporalio/external-storage-s3-aws-sdk": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "protobufjs": "8.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@tsconfig/node22": "^22.0.0"
  }
}
